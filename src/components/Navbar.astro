---
interface Props {
  isLegalPage?: boolean;
}

const { isLegalPage = false } = Astro.props;
const appStoreUrl = 'https://apps.apple.com/fr/app/bibleshot-un-shot-un-quiz/id6753938756';
---

<nav class="navbar" aria-label="Navigation principale">
  <div class="container nav-content">
    <a href="/" class="logo" aria-label="BibleShot — Accueil">
      <img src="/assets/images/icon.png" alt="" width="1024" height="1024">
      <span>BibleShot</span>
    </a>

    {isLegalPage ? (
      <a href="/" class="nav-back">← Retour au site</a>
    ) : (
      <>
        <div class="nav-links" id="nav-links">
          <a href="#rituel" class="nav-link">Le rituel</a>
          <a href="#widget" class="nav-link">Le widget</a>
          <a href="#fonctionnalites" class="nav-link">L’expérience</a>
          <a href="#faq" class="nav-link">FAQ</a>
        </div>
        <a href={appStoreUrl} class="nav-download">Télécharger <span>↗</span></a>
        <button class="burger-menu" aria-label="Ouvrir le menu" aria-controls="nav-links" aria-expanded="false">
          <span></span><span></span>
        </button>
      </>
    )}
  </div>
</nav>
