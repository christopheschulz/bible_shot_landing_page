---
interface Props {
  isLegalPage?: boolean;
}

const { isLegalPage = false } = Astro.props;
---

<nav class="navbar">
    <div class="container">
        <div class="nav-content">
            {isLegalPage ? (
                <a href="/" class="logo">
                    <span class="logo-icon">
                        <img src="/assets/images/icon.png" alt="BibleShot logo">
                    </span>
                    <span class="logo-text">BibleShot</span>
                </a>
                <a href="/" class="btn-secondary btn-small">Retour</a>
            ) : (
                <>
                    <div class="logo">
                        <span class="logo-icon">
                            <img src="/assets/images/icon.png" alt="BibleShot logo">
                        </span>
                        <span class="logo-text">BibleShot</span>
                    </div>
                    <ul class="nav-menu">
                        <li><a href="#hero" class="nav-link">Accueil</a></li>
                        <li><a href="#concept" class="nav-link">Concept</a></li>
                        <li><a href="#features" class="nav-link">Fonctionnalités</a></li>
                        <li><a href="#quiz" class="nav-link">Quiz</a></li>
                        <li><a href="#themes" class="nav-link">Thèmes</a></li>
                        <li><a href="#why-section" class="nav-link">Points forts</a></li>
                        <li><a href="#faq" class="nav-link">FAQ</a></li>
                        <li><a href="#download" class="nav-app-store-badge" aria-label="Télécharger sur l'App Store">
                            <img src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/fr-fr?size=250x83&releaseDate=1234569600" alt="Télécharger dans l'App Store" height="40">
                        </a></li>
                    </ul>
                    <button class="burger-menu" aria-label="Menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                </>
            )}
        </div>
    </div>
</nav>
